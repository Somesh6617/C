#include <stdio.h>
#include <math.h>

int isPerfectSquare(int n) {
    if (n < 0) return 0;
    int root = (int)sqrt(n);
    return root * root == n;
}

int main() {
    int num;
    scanf("%d", &num);
    if (isPerfectSquare(num))
        printf("Perfect Square\n");
    else
        printf("Not Perfect Square\n");
    return 0;
}
